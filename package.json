{
	"name": "sandctl",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "scripts/build.sh",
		"build-all": "scripts/build-all.sh",
		"test": "bun test",
		"test:unit": "bun test tests/unit/",
		"test:e2e": "bun run build && bun test tests/e2e/",
		"test:e2e:config-path-contract": "bun run build && bun test tests/e2e/config-path-contract.test.ts",
		"test:e2e:contracts": "bun run build && bun test tests/e2e/config-path-contract.test.ts tests/e2e/init-new-agent-contract.test.ts tests/e2e/legacy-sessions-contract.test.ts",
		"test:e2e:contracts:ci": "bun test tests/e2e/config-path-contract.test.ts tests/e2e/init-new-agent-contract.test.ts tests/e2e/legacy-sessions-contract.test.ts",
		"test:e2e:live": "SANDCTL_LIVE_SMOKE=1 bun test tests/e2e/live-smoke.test.ts",
		"lint": "biome check src/ tests/",
		"fmt": "biome format --write src/ tests/",
		"check-fmt": "biome format src/ tests/"
	},
	"dependencies": {
		"@google-cloud/compute": "^6.11.0",
		"@inquirer/prompts": "^8.4.3",
		"async-lock": "^1.4.1",
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"luxon": "^3.7.2",
		"nanospinner": "^1.2.2",
		"ssh2": "^1.17.0",
		"validator": "^13.15.35",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^25.9.1",
		"@types/ssh2": "^1.15.5",
		"bun-types": "^1.3.14",
		"typescript": "^6.0.3"
	}
}
